{
  "name": "workdsh-plugin-craftcad-panel",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "WorkDSH right-hand panel for CraftCAD: open DXF/PDF/PNG and edit DXF in place (save back to the same file)",
  "exports": {
    ".": {
      "default": "./dist/index.js"
    },
    "./client": {
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}

      "expr": "round(({科研学生用水人数}*{科研学生用水定额}+{办公用水人数}*{办公用水定额})/1000*(1+{未预见系数}/100), 2)",
      "deps": [
        "科研学生用水人数",
        "科研学生用水定额",
        "办公用水人数",
        "办公用水定额",
        "未预见系数"
      ],
      "target": "最高日用水量",
      "recheck": "闭合"
    },
    {
      "id": "R-消防用水量合计",
      "label": "消防用水量总计",
      "expr": "{室外消火栓系统用水量}+{室内消火栓系统用水量}+{自动喷水灭火系统用水量}",
      "deps": [
        "室外消火栓系统用水量",
        "室内消火栓系统用水量",
        "自动喷水灭火系统用水量"
      ],
      "target": "消防用水量总计",
      "recheck": "闭合"
    },
    {
      "id": "R-总计算负荷",
      "label": "总计算负荷",
      "expr": "round({本项目面积口径}*({空调负荷密度指标}+{照明及其他负荷密度指标})/1000, 0)",
      "deps": [
        "负荷估算面积口径",
        "空调负荷密度指标",
        "照明及其他负荷密度指标"
      ],
      "target": "总计算负荷",
      "recheck": "未解(缺口径)"
    },
    {
      "id": "R-供电容量匹配",
      "label": "变压器容量匹配校核",
      "expr": "{原变电站变压器容量} -> {增容后变压器容量} >= {总计算负荷}/{功率因数} => 通过；口径不全 => 待审",
      "deps": [
        "原变电站变压器容量",
        "增容后变压器容量",
        "总计算负荷"
      ],
      "target": "供电容量匹配校核",
      "recheck": "闭合"
    },
    {
      "id": "R-冷负荷",
      "label": "冷负荷",
      "expr": "round({本项目建筑面积}*{单位面积冷负荷指标}/1000, 0)",
      "deps": [
        "本项目建筑面积",
        "单位面积冷负荷指标"
      ],
      "target": "冷负荷",
      "recheck": "阻塞(冲突未裁决)"
    },
    {
      "id": "R-热负荷",
      "label": "热负荷",
      "expr": "round({本项目建筑面积}*{单位面积热负荷指标}/1000, 0)",
      "deps": [
        "本项目建筑面积",
        "单位面积热负荷指标"
      ],
      "target": "热负荷",
      "recheck": "阻塞(冲突未裁决)"
    },
    {
      "id": "R-年用水量",
      "label": "年总用水量",
      "expr": "round({教师用水日水量}*{年工作天数}/10000, 2)+round({学生用水日水量}*{年工作天数}/10000, 2)+round(({教师用水日水量}+{学生用水日水量})*{年工作天数}/10000*({未预见系数}/100), 2)",
      "deps": [
        "教师用水日水量",
        "学生用水日水量",
        "年工作天数",
        "未预见系数"
      ],
      "target": "年总用水量",
      "recheck": "闭合"
    }
  ],
  "return_contract": {
    "draft_md": "正文 Markdown，数值一律 {{node:N-xxxxxxxxxxxx}}，不得写字面量",
    "node_mentions": "[{node_id, char_span, form}]",
    "new_claims": "[{text, supports[], evidence[]}]",
    "unresolved": "[{what, why, need_from_client}]"
  }
}
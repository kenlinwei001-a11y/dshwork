      "status": "unverified",
      "toulmin": {
        "claim": "本项目设计等级为：3类建筑 / 50年 / 耐火二级 / 抗震7度",
        "grounds": "《民用建筑设计通则》建筑类别划分；《建筑设计防火规范》高层民用建筑耐火等级；国家抗震烈度划分区域表",
        "warrant": "规范给定的分类与设防标准适用于本项目所在地与建筑高度",
        "backing": "GB50352-2005 / GB50016-2014 / 抗震区划表",
        "qualifier": "",
        "rebuttal": "——"
      },
      "evidence_refs": [
        "EV-规范-建筑-04",
        "EV-规范-建筑-01"
      ]
    },
    {
      "id": "CL-技术-02",
      "text": "上部结构采用装配整体式钢筋混凝土框架-剪力墙结构；地下室基础拟采用桩筏基础，基础埋深不小于3.5m。",
      "claim_type": "conclusion",
      "status": "unverified",
      "toulmin": {
        "claim": "本项目采用装配整体式钢筋混凝土框架-剪力墙结构 + 桩筏基础",
        "grounds": "12 层、建筑高度控制 60m、抗震 7 度、IV 类场地、特征周期 0.9s；装配式政策要求",
        "warrant": "该结构形式在给定高度与抗震条件下满足承载与变形要求（原文给出，属方案比选结论）",
        "backing": "JGJ 3-2010 / GB50011-2010",
        "qualifier": "拟采用",
        "rebuttal": "——"
      },
      "evidence_refs": [
        "EV-规范-结构-03",
        "EV-规范-结构-01"
      ]
    },
    {
      "id": "CL-技术-03",
      "text": "本工程采用变制冷剂流量多联机系统作为空调冷热源，室外机集中放置在屋面上，室内机为卡式或内藏风管机，并设新风机组供新风。",
      "claim_type": "conclusion",
      "status": "unverified",
      "toulmin": {
        "claim": "本项目空调系统采用变制冷剂流量多联机系统",
        "grounds": "冷负荷 2473kW、热负荷 1465kW；建筑为 12 层科研用房，房间使用时间不统一",
        "warrant": "多联机系统适合分区、分时使用且无需集中机房（属方案比选结论，原文未展开比选过程）",
        "backing": "JGJ 174-2010 / DGJ08-107-2015",

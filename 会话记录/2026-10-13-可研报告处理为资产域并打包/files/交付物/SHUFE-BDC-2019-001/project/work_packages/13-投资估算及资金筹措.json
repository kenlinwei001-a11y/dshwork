      "label": "总投资（筹措口径）",
      "expr": "round({国拨资金}+{学校自筹资金}, 2)",
      "deps": [
        "国拨资金",
        "学校自筹资金"
      ],
      "target": "总投资",
      "recheck": "闭合"
    },
    {
      "id": "R-国拨资金占比",
      "label": "国拨资金占比",
      "expr": "round({国拨资金}/{总投资}*100, 2)",

    {
      "id": "R-基本预备费",
      "label": "基本预备费",
      "expr": "round(({建筑安装工程费用}+{工程建设其他费})*{基本预备费费率}/100, 2)",
      "deps": [
        "建筑安装工程费用",
        "工程建设其他费",
        "基本预备费费率"
      ],
      "target": "基本预备费",
      "recheck": "闭合"
    },
    {
      "id": "R-单位造价",
      "label": "单位造价（总投资口径）",
      "expr": "round({总投资}*10000/{本项目建筑面积}, 0)",
      "deps": [
        "总投资",
        "本项目建筑面积"
      ],
      "target": "单位造价（总投资口径）",
      "recheck": "闭合"
    },
    {

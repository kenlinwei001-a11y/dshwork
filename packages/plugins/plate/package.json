{
  "name": "workdsh-plugin-plate",
  "version": "1.7.0",
  "private": true,
  "type": "module",
  "description": "AI rich-text documents (Plate) as a parallel, zero-intrusion WorkDSH plugin; all LLM access via the Harness llm service",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "default": "./dist/client.browser.js"
    }
  },
  "files": [
    "cordis.patch.yml",
    "dist",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../../scripts/build-plate.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.121",
    "@ariakit/react": "^0.4.40",
    "@platejs/ai": "53.3.12",
    "@platejs/basic-nodes": "53.0.0",
    "@platejs/combobox": "^53.0.0",
    "@platejs/markdown": "53.3.12",
    "@platejs/media": "53.1.4",
    "@platejs/selection": "^53.1.6",
    "@platejs/slash-command": "53.0.0",
    "@platejs/suggestion": "^53.2.3",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-toolbar": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "ai": "7.0.118",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "jszip": "3.10.1",
    "lucide-react": "1.45.0",
    "platejs": "53.3.14",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.3",
    "@deepseek-ai/dsh-agent-default-model": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-api-session-controller": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-connection": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-sidebar-documentpreview": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-llm": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-tools": "0.1.7-alpha.1",
    "react": "19.2.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.3",
    "@deepseek-ai/dsh-agent-default-model": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-api-session-controller": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-connection": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-sidebar-documentpreview": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-llm": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-tools": "0.1.7-alpha.1",
    "@types/node": "22.19.0",
    "@types/react": "19.2.14",
    "react": "19.2.4"
  }
}

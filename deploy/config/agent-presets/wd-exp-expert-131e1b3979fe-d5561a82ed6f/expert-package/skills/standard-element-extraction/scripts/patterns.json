      "id": "P-LIMIT-DL",
      "name": "检出限声明",
      "category": "C1",
      "primitives": [
        "P1"
      ],
      "triggers": [
        "检出限",
        "方法检出限"
      ],
      "require": "numeric",
      "extract": "检出限\\D{0,10}(\\d+(?:\\.\\d+)?)\\s*(mg/L|μg/L|μg/ml|mg/kg)",
      "predicate": {
        "field": "方法检出限",
        "op": "==",
        "value": "$1",
        "unit": "$2"
      },
      "check_target": {
        "field": "方法检出限",
        "hints": [
          "检出限",
          "LOD",
          "DL"
        ],
        "strategy": "field_label"
      },
      "on_missing": "FAIL"
    },

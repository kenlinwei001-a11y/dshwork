{
 "schema": "capability-registry/1",
 "capabilities": {
  "text.probe": {
   "kind": "tool",
   "version": "1.0.0",
   "impl": {
    "runtime": "python3",
    "entry": "${SKILL}/scripts/cap.py",
    "args": [
     "probe",
     "{pdf}"
    ]
   },
   "config_schema": {
    "pdf": {
     "type": "path",
     "required": true
    }
   },
   "contract": {
    "outputs": [
     "route",
     "pages",
     "fonts",
     "images"
    ],
    "exit": {
     "0": "ok"
    }
   },
   "owner": "standard-element-extraction",
   "conformance": [
    "HJ84-2016.pdf -> route=OCR",
    "HJ535-2009.txt -> route=PDF_TEXT"
   ]
  },
  "ocr.engine": {
   "kind": "tool",
   "version": "0.1.0",
   "impl": {
    "runtime": "bin",
    "entry": "hj84-2016/out/ocr",
    "args": [
     "{pdf}",
     "{outdir}",
     "{dpi}"
    ]
   },
   "config_schema": {
    "engine": {
     "type": "enum",
     "values": [
      "apple-vision",
      "user-model",
      "fallback-none"
     ],
     "default": "apple-vision"
    },
    "dpi": {
     "type": "int",
     "default": 600,
     "range": [
      150,
      1200
     ]
    },
    "endpoint": {
     "type": "string",
     "required": false,
     "when": "engine==user-model"
    }
   },
   "contract": {
    "outputs": [
     "page-*.png",
     "page-*.tsv"
    ],
    "exit": {
     "0": "ok"
    }
   },
   "fallback": [
    "user-model",
    "apple-vision",
    "fallback-none"
   ],
   "owner": "输入侧（用户 OCR 模型）",
   "conformance": [
    "14/14 页出图",
    "逐页 tsv 非空",
    "20 张 golden 字串全中"
   ]
  },
  "clause.split": {
   "kind": "tool",
   "version": "1.0.0",
   "impl": {
    "runtime": "python3",
    "entry": "${SKILL}/scripts/clause_split.py",
    "args": [
     "--text",
     "{text}",
     "--out",
     "{out}"
    ]
   },
   "config_schema": {
    "text": {
     "type": "path"
    },
    "out": {
     "type": "path"
    },
    "min_level": {
     "type": "int",
     "default": 1
    }
   },
   "contract": {
    "outputs": [
     "clauses",
     "toc",
     "n"
    ],
    "precondition": "text.quality.route==PDF_TEXT"
   },
   "owner": "standard-element-extraction",
   "conformance": [
    "干净文本 n=89 且 toc 非空"
   ]
  },
  "audit.lint": {
   "kind": "tool",
   "version": "1.0.0",
   "impl": {
    "runtime": "python3",
    "entry": "${SKILL}/scripts/cap.py",
    "args": [
     "lint",
     "--ses",
     "{ses}"
    ]
   },
   "config_schema": {
    "ses": {
     "type": "path",
     "required": true
    }
   },
   "contract": {
    "outputs": [
     "errors",
     "warnings",
     "ok"
    ],
    "exit": {
     "0": "ok",
     "1": "blocking"
    }
   },
   "owner": "standard-element-extraction",
   "conformance": [
    "规则卡齐全时 ok=true"
   ]
  },
  "audit.ontology": {
   "kind": "tool",
   "version": "1.0.0",
   "impl": {
    "runtime": "python3",
    "entry": "${SKILL}/scripts/validate_ontology.py",
    "args": [
     "--ses",
     "{ses}"
    ]
   },
   "config_schema": {
    "ses": {
     "type": "path"
    },
    "graph": {
     "type": "path",
     "required": false
    }
   },
   "contract": {
    "outputs": [
     "ERROR",
     "WARN"
    ]
   },
   "owner": "standard-element-extraction",
   "status": "OK",
   "conformance": []
  },
  "llm.semantic": {
   "kind": "llm",
   "version": "1.0.0",
   "impl": {
    "runtime": "agent",
    "skill": "standard-element-extraction",
    "schema_ref": "references/standard-element-schema.md"
   },
   "config_schema": {
    "step": {
     "type": "enum",
     "values": [
      "clauses",
      "elements",
      "rules",
      "fix",
      "handoff"
     ]
    },
    "model": {
     "type": "string",
     "default": "host-default"
    },
    "max_retry": {
     "type": "int",
     "default": 3
    }
   },
   "contract": {
    "outputs": [
     "json"
    ],
    "validation": "validator.py",
    "on_fail": "needs_review"
   },
   "owner": "standard-element-extraction"
  },
  "merge.ses": {
   "kind": "tool",
   "version": "1.0.0",
   "impl": {
    "runtime": "python3",
    "entry": "${SKILL}/scripts/merge_ses.py",
    "args": [
     "--out",
     "{out}"
    ]
   },
   "config_schema": {
    "out": {
     "type": "path",
     "required": true
    },
    "slug": {
     "type": "string",
     "required": false
    }
   },
   "contract": {
    "outputs": [
     "ses.json",
     "counts"
    ],
    "exit": {
     "0": "ok"
    }
   },
   "owner": "standard-element-extraction",
   "conformance": [
    "同一 out 目录重跑 sha256_12 一致（除 extraction.date）"
   ]
  },
  "graph.semantica": {
   "kind": "tool",
   "executor": "mcp",
   "version": "0.3.0",
   "impl": {
    "server": "semantica",
    "resources": {
     "summary": "semantica://graph/summary",
     "decisions": "semantica://decisions/list"
    },
    "ops": {
     "summary": "semantica://graph/summary",
     "decisions": "semantica://decisions/list",
     "ingest": "QUEUE_ONLY（写 payload 到 out/semantica-queue/，待 graph.ingest 工具挂载后推送）"
    }
   },
   "config_schema": {
    "op": {
     "type": "enum",
     "values": [
      "summary",
      "decisions",
      "ingest"
     ],
     "default": "summary"
    },
    "timeout_s": {
     "type": "int",
     "default": 8,
     "range": [
      1,
      60
     ]
    },
    "namespaced": {
     "type": "bool",
     "default": true
    }
   },
   "contract": {
    "outputs": [
     "node_count",
     "decision_count",
     "graph_ready"
    ],
    "on_timeout": "unavailable_non_blocking",
    "ingest": "dry-run only；命名空间 std:<slug>；写入工具未挂载（requires graph.ingest tool）"
   },
   "status": "PENDING",
   "status_reason": "读：summary 可用；写：MCP 未挂写入工具，改走队列",
   "owner": "semantica MCP（共享图）",
   "conformance": [
    "summary 可读且 graph_ready=true",
    "超时返回 unavailable 且不改变 gate"
   ],
   "reason": "仅生成 payload 到 out/semantica-queue/，未写入图库、判定链上未读取；登记为 OK 属假证据",
   "promote_when": "semantica MCP 提供写工具，且至少一条 review 路径实际读回 semantica://graph/summary 并计入判定"
  },
  "audit.findings": {
   "kind": "tool",
   "version": "1.0.0",
   "impl": {
    "runtime": "python3",
    "entry": "${SKILL}/scripts/audit_findings.py",
    "args": [
     "--out",
     "{out}",
     "--text",
     "{text}"
    ]
   },
   "config_schema": {
    "out": {
     "type": "path"
    },
    "text": {
     "type": "path"
    }
   },
   "contract": {
    "outputs": [
     "audit_findings.json"
    ],
    "target_size_kb": 6
   },
   "owner": "standard-element-extraction",
   "conformance": [
    "HJ84: 0.16s / ~1KB；锚/覆盖/谓词/ID 一次算完"
   ],
   "status": "STANDARD",
   "note": "轻量审计标准入口：审计员只读本文件 + 抽 5 样本，不重读全文"
  },
  "ocr.to_text": {
   "kind": "mcp",
   "version": "0.1.0",
   "status": "PENDING_DEPLOY",
   "status_reason": "本机未部署 OCR MCP；脚本不能直调 MCP，由 agent 在契约指引下调用",
   "impl": {
    "server": "<待配置：MCP server 名>",
    "tool": "<待配置：识别工具名>",
    "input": "pdf 或 page image",
    "output": "每页文本 + 置信度"
   },
   "config": {
    "dpi": 600,
    "lang": "chi_sim+eng",
    "min_conf": 0.5,
    "page_marker": "===== PAGE {n} ====="
   },
   "contract": {
    "outputs": [
     "standards/<slug>.ocr.txt",
     "standards/<slug>.source.json"
    ],
    "on_unavailable": "登记 GAP-DATA，要求上传可选文本的 PDF 或人工校订文本，不猜字"
   },
   "fallback_capability": "parse.pdf.text（有文本层时优先，不调 OCR）",
   "owner": "standard-element-extraction"
  }
 },
 "skill_root": "${SKILL}",
 "executors": {
  "tool": "runner.py 子进程",
  "mcp": "MCP 资源读取（agent 代执行，不做判断）",
  "llm": "agent + schema 校验"
 }
}